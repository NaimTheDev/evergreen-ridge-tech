# Resend (https://resend.com) — used to actually send email
RESEND_API_KEY=

# Verified "from" address in Resend (must be on a domain you've verified with Resend,
# e.g. notifications@evergreenridgetech.com). Use onboarding@resend.dev for local testing
# before a domain is verified.
FROM_EMAIL=

# Where lead notifications (contact form + estimator submissions) are delivered
CONTACT_TO_EMAIL=naim@evergreenridgetech.com

# Comma-separated list of allowed CORS origins for the production/staging frontend(s)
ALLOWED_ORIGINS=https://www.evergreenridgetech.com,https://evergreenridgetech.com,http://localhost:3000

PORT=3001
