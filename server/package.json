{
  "name": "evergreen-ridge-tech-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --jsx=automatic --outfile=dist/index.js --external:@react-pdf/renderer --external:react --external:react/jsx-runtime && cp -r src/assets dist/assets",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "react": "^18.3.1",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.31",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
